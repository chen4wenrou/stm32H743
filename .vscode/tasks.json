{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "STM32 Build",
            "type": "shell",
            "command": "ninja",
            "args": ["-j4"],
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Build STM32 project using Ninja"
        },
        {
            "label": "STM32 Clean",
            "type": "shell",
            "command": "ninja",
            "args": ["clean"],
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "group": "build",
            "problemMatcher": [],
            "detail": "Clean STM32 build artifacts"
        }
    ]
}